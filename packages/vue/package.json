  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "vue": ">=3.3"
  },
  "dependencies": {
    "nurblings": "workspace:*"
  },
  "devDependencies": {
    "@vue/server-renderer": "^3.5.42",
    "@vue/test-utils": "^2.5.0",
    "happy-dom": "^20.14.3",
    "vue": "^3.5.42"
  }
