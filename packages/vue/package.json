{
  "name": "@nurblings/vue",
  "version": "0.0.0",
  "description": "Vue 3 component for nurblings: deterministic avatars, any string in, a small curious creature out.",
  "license": "MIT",
  "author": "Albert Esparragoza",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/albertesparragoza/nurblings.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/albertesparragoza/nurblings#readme",
  "bugs": "https://github.com/albertesparragoza/nurblings/issues",
  "keywords": [
    "avatar",
    "identicon",
    "svg",
    "deterministic",
    "generative",
    "vue",
    "nuxt"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
