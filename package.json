{
  "name": "nurblings-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.2.2",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" build",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --filter \"./packages/*\" typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "publint": "pnpm -r --filter \"./packages/*\" exec publint",
    "attw": "pnpm -r --filter \"./packages/*\" --filter \"!@nurblings/astro\" exec attw --pack . --profile esm-only",
    "size": "size-limit",
    "sheet": "tsup scripts/container-sheet.ts --format esm --out-dir wip/.sheet --silent && node wip/.sheet/container-sheet.js",
    "changeset": "changeset",
    "knip": "knip"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.15",
    "@changesets/cli": "^3.0.3",
    "@size-limit/preset-small-lib": "^14.2.0",
    "@vitest/coverage-v8": "^5.0.5",
    "knip": "6.42.1",
    "publint": "^0.3.25",
    "size-limit": "^14.2.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
