{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.{ts,mjs}"],
      "project": ["scripts/**/*.{ts,mjs}", "*.{ts,mjs}"]
    },
    "packages/*": {
      "project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}"]
    },
    "packages/vue": {
      "project": ["src/**/*.{ts,vue}", "test/**/*.ts"]
    },
    "packages/astro": {
      "project": ["src/**/*.{ts,astro}", "test/**/*.ts"]
    },
    "examples/next-app": {
      "project": ["**/*.{ts,tsx}"]
    },
    "examples/nuxt": {
      "project": ["**/*.{ts,vue}"]
    },
    "examples/astro": {
      "project": ["**/*.{ts,astro,mjs}"]
    },
    "site": {
      "project": ["src/**/*.{ts,astro,mjs,mdx}", "*.mjs"],
      "ignoreDependencies": ["@fontsource-variable/geist-mono"]
    }
  },
  "ignoreIssues": {
    "packages/vue/src/index.ts": ["duplicates"]
  }
}
