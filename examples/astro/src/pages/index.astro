---
import { Nurbling } from '@nurblings/astro'

const seeds = [
  'ada@example.com',
  'grace.hopper',
  'Alan Turing',
  'katherine johnson',
  'linus',
  'margaret_hamilton',
  'barbara.liskov',
  'dennis',
  'hedy',
  'radia',
  'sophie wilson',
  'joan clarke',
]

const sizes = [24, 48, 96, 192]
const backgrounds = ['circle', 'squircle', 'square'] as const
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Nurblings</title>
    <style>
      :root {
        color-scheme: light dark;
      }

      body {
        margin: 0;
        background: #f7f5f2;
        color: #1a1a1a;
        font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
      }

      main {
        max-width: 720px;
        margin: 0 auto;
        padding: 2.5rem 1.5rem 4rem;
      }

      h1 {
        margin: 0 0 0.5rem;
        font-size: 2rem;
      }

      p.lede {
        margin: 0 0 2.5rem;
        opacity: 0.75;
      }

      section {
        margin-bottom: 2.5rem;
      }

      h2 {
        font-size: 1rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        opacity: 0.6;
        margin: 0 0 1rem;
      }

      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
        gap: 1.25rem;
        text-align: center;
      }

      .grid figure {
        margin: 0;
      }

      .grid figcaption {
        margin-top: 0.4rem;
        font-size: 0.75rem;
        opacity: 0.7;
        overflow-wrap: anywhere;
      }

      .row {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-end;
        gap: 1.5rem;
      }

      .row figure {
        margin: 0;
        text-align: center;
      }

      .row figcaption {
        margin-top: 0.4rem;
        font-size: 0.75rem;
        opacity: 0.7;
      }

      @media (prefers-color-scheme: dark) {
        body {
          background: #16161a;
          color: #f2f2f2;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <h1>Nurblings</h1>
      <p class="lede">Any string in, a small curious creature out.</p>

      <section>
        <h2>Gallery</h2>
        <div class="grid">
          {
            seeds.map((seed) => (
              <figure>
                <Nurbling seed={seed} size={64} title={seed} />
                <figcaption>{seed}</figcaption>
              </figure>
            ))
          }
        </div>
      </section>

      <section>
        <h2>Sizes</h2>
        <div class="row">
          {
            sizes.map((size) => (
              <figure>
                <Nurbling seed="ada@example.com" size={size} title="ada@example.com" />
                <figcaption>{size}px</figcaption>
              </figure>
            ))
          }
        </div>
      </section>

      <section>
        <h2>Backgrounds</h2>
        <div class="row">
          {
            backgrounds.map((background) => (
              <figure>
                <Nurbling
                  seed="ada@example.com"
                  size={64}
                  background={background}
                  title="ada@example.com"
                />
                <figcaption>{background}</figcaption>
              </figure>
            ))
          }
        </div>
      </section>

      <section>
        <h2>Animated</h2>
        <div class="row">
          <figure>
            <Nurbling seed="ada@example.com" size={96} animate title="ada@example.com" />
            <figcaption>Hover me</figcaption>
          </figure>
        </div>
      </section>
    </main>
  </body>
</html>
