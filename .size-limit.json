[
  {
    "name": "nurblings: nurbling()",
    "path": "packages/nurblings/dist/index.js",
    "import": "{ nurbling }",
    "limit": "8 KB"
  },
  {
    "name": "nurblings: everything, createNurblings included",
    "path": "packages/nurblings/dist/index.js",
    "import": "*",
    "limit": "8.75 KB"
  },
  {
    "name": "nurblings/transition: morph()",
    "path": "packages/nurblings/dist/transition.js",
    "import": "{ morph }",
    "limit": "1 KB"
  },
  {
    "name": "@nurblings/element",
    "path": "packages/element/dist/index.js",
    "import": "*",
    "limit": "1 KB",
    "ignore": ["nurblings"]
  },
  {
    "name": "@nurblings/vue",
    "path": "packages/vue/dist/index.js",
    "import": "*",
    "limit": "1 KB",
    "ignore": ["nurblings", "vue"]
  },
  {
    "name": "@nurblings/react",
    "path": "packages/react/dist/index.js",
    "import": "*",
    "limit": "1 KB",
    "ignore": ["nurblings", "react", "react/jsx-runtime"]
  }
]
