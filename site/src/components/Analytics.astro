---
// PostHog (cookieless) and Sentry (errors only), or nothing at all.
//
// No key, no tag: each block renders only when its environment variable is set,
// so the site builds and runs the same before the keys exist, and removing a
// key uninstalls it. Production only: a dev session never sends an event.
//
// PostHog keeps everything in memory, so it writes no cookie and no
// localStorage and needs no consent banner. The cost: no returning-visitor
// identity. It honours Do Not Track, and session recording is off. Sentry's
// loader is a small stub that fetches the SDK only when something throws;
// tracing, replay and profiling are off.
//
// Configure as GitHub repository variables (the site is built in CI):
//   PUBLIC_POSTHOG_KEY   the project API key (phc_...)
//   PUBLIC_POSTHOG_HOST  https://eu.i.posthog.com or https://us.i.posthog.com
//   PUBLIC_SENTRY_KEY    the public key from the DSN, before the @
const prod = import.meta.env.PROD
const posthogKey = import.meta.env.PUBLIC_POSTHOG_KEY
const posthogHost = import.meta.env.PUBLIC_POSTHOG_HOST || 'https://eu.i.posthog.com'
const sentryKey = import.meta.env.PUBLIC_SENTRY_KEY

const usePosthog = prod && !!posthogKey
const useSentry = prod && !!sentryKey
---

{
  useSentry && (
    <script
      is:inline
      async
      crossorigin="anonymous"
      src={`https://js.sentry-cdn.com/${sentryKey}.min.js`}
    />
  )
}

{
  useSentry && (
    <script
      is:inline
      set:html={`
    window.sentryOnLoad = function () {
      Sentry.init({
        tracesSampleRate: 0,
        replaysSessionSampleRate: 0,
        replaysOnErrorSampleRate: 0,
        ignoreErrors: ['ResizeObserver loop', 'Non-Error promise rejection captured'],
        denyUrls: [/extensions\\//i, /^chrome:\\/\\//i, /^moz-extension:\\/\\//i],
      });
    };
  `}
    />
  )
}

{
  usePosthog && (
    <script
      is:inline
      set:html={`
    !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init me ws ys ps bs capture je Di ks register register_once register_for_session unregister unregister_for_session Ps getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty Es $s createPersonProfile Is opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing Ss debug xs getPageViewId captureTraceFeedback captureTraceMetric".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
    posthog.init(${JSON.stringify(posthogKey)}, {
      api_host: ${JSON.stringify(posthogHost)},
      persistence: 'memory',
      disable_persistence: true,
      respect_dnt: true,
      disable_session_recording: true,
      capture_pageview: true,
      capture_pageleave: true,
    });
  `}
    />
  )
}
