---
// Nurbi's story: the drawing beside the text. Its layers change as the reader
// moves through the story; the page sets `at-N` (reached chapter N) and
// `now-N` (on chapter N) on the stage. Nurbi's parts come from the library's
// own drawing of him, split so each can arrive on its own: one curve whose two
// handles sit exactly where his antennae will be, then a construction sketch
// of him, then his traced outline, then his body and face.
import { nurbling } from 'nurblings'

const match = (text: string, pattern: RegExp) => text.match(pattern) as RegExpMatchArray
const f = (v: number) => Math.round(v * 100) / 100

const drawing = nurbling('nurbi', { animate: false, frame: 'full', size: 400 })
const viewBox = match(drawing, /viewBox="([^"]+)"/)[1]
const inner = drawing.slice(drawing.indexOf('</title>') + 8, drawing.lastIndexOf('</svg>'))
// the stored drawing: two antennae (a line and a square each), the body group, then the face
const [, handles, bodyGroup, face] = match(
  inner,
  /^((?:<line[^>]*\/><rect[^>]*\/>){2})(<g transform="[^"]*">.*?<\/g>)(.*)$/s,
)
const place = match(bodyGroup as string, /^<g transform="([^"]*)">/)[1]
const outline = match(bodyGroup as string, /<path d="([^"]+)"/)[1] as string
const body = (bodyGroup as string).replace(/^<g[^>]*>/, '').replace(/<\/g>$/, '')

// The construction sketch, in his own drawing units, measured from the outline.
// Straight lines run along each plate edge of the crown and well past it; long
// curves stand for the soft body; guides mark the centre and each plate band.
type Pt = readonly [number, number]
const pts: Pt[] = [...outline.matchAll(/([\d.]+),([\d.]+)/g)].map((m) => [
  Number(m[1]),
  Number(m[2]),
])
// the crown: the point before the first straight run, then every point of it
const run = match(outline, /([\d.]+),([\d.]+)((?:L[\d.]+,[\d.]+)+)/)
const crown: Pt[] = [
  [Number(run[1]), Number(run[2])],
  ...[...(run[3] as string).matchAll(/L([\d.]+),([\d.]+)/g)].map(
    (m): Pt => [Number(m[1]), Number(m[2])],
  ),
]
const past = ([ax, ay]: Pt, [bx, by]: Pt, k = 1.6) =>
  `M${f(ax - (bx - ax) * k)},${f(ay - (by - ay) * k)}L${f(bx + (bx - ax) * k)},${f(by + (by - ay) * k)}`
const apexY = Math.min(...crown.map(([, y]) => y))
const baseY = Math.max(...pts.map(([, y]) => y))
const [wideX, wideY] = pts.reduce((a, b) => (b[0] > a[0] ? b : a))
const ellipse = (cy: number, rx: number, ry: number) =>
  `M${f(50 - rx)},${f(cy)}A${f(rx)},${f(ry)} 0 1 0 ${f(50 + rx)},${f(cy)}A${f(rx)},${f(ry)} 0 1 0 ${f(50 - rx)},${f(cy)}`
const sketch = [
  `M50,${f(apexY - 8)}L50,${f(baseY + 5)}`,
  ...[...new Set(crown.map(([, y]) => y))].filter((y) => y !== apexY).map((y) => `M6,${y}L94,${y}`),
  ...crown.slice(1).map((p, i) => past(crown[i] as Pt, p)),
  ellipse(wideY, wideX - 50, baseY - wideY),
  ellipse((apexY + baseY) / 2, (wideX - 50) * 1.04, (baseY - apexY) / 2),
]

// the first curve: anchored where his antennae root, bent by handles that end
// where their square tips are, so the handles it leaves behind become them
const [[r1x, r1y, t1x, t1y], [r2x, r2y, t2x, t2y]] = [
  ...(handles as string).matchAll(/<line x1="([\d.]+)" y1="([\d.]+)" x2="([\d.]+)" y2="([\d.]+)"/g),
].map((m) => m.slice(1).map(Number)) as [number[], number[]]
const curve = `M${r1x},${r1y}C${t1x},${t1y} ${t2x},${t2y} ${r2x},${r2y}`
const knob = 20

const still = { animate: false, frame: 'full', size: 400 } as const
const flicker = ['grace', 'linus', 'radia', 'hedy', 'alan', 'joan', 'tim', 'margaret'].map((seed) =>
  nurbling(seed, { ...still, title: seed }),
)
const family = [
  'ada',
  'grace',
  'linus',
  'radia',
  'hedy',
  'alan',
  'joan',
  'tim',
  'margaret',
  'dennis',
  'barbara',
  'frances',
  'guido',
  'sophie',
  'anders',
  'katherine',
].map((seed) => nurbling(seed, { size: 72, background: 'circle', animate: false, title: seed }))
---

<div class="nurbi-stage" id="nurbi-stage" aria-hidden="true">
  <div class="layer drawing">
    <svg viewBox={viewBox}>
      <g class="first-curve">
        <path class="stroke" d={curve} pathLength="1"></path>
        <path class="arm" d={`M${r1x},${r1y}L${t1x},${t1y}`} pathLength="1"></path>
        <path class="arm" d={`M${r2x},${r2y}L${t2x},${t2y}`} pathLength="1"></path>
        <rect class="knob" x={t1x - knob / 2} y={t1y - knob / 2} width={knob} height={knob}></rect>
        <rect class="knob" x={t2x - knob / 2} y={t2y - knob / 2} width={knob} height={knob}></rect>
      </g>
      <g transform={place}>
        <g class="sketch">{sketch.map((d, i) => <path d={d} pathLength="1" style={`--i:${i}`} />)}</g>
        <g class="body" set:html={body} />
        <path class="trace" d={outline} pathLength="1"></path>
      </g>
      <g class="face" set:html={face} />
      <g class="handles" set:html={handles} />
    </svg>
  </div>
  <div class="layer flicker">{flicker.map((svg) => <span set:html={svg} />)}</div>
  <figure class="layer settled">
    <span set:html={nurbling('ada', { ...still, title: 'ada' })} />
    <figcaption>ada</figcaption>
  </figure>
  <div class="layer family">{family.map((svg) => <span set:html={svg} />)}</div>
  <div class="layer result" id="nurbi-result" set:html={nurbling('nurbi', { ...still, title: 'Nurbi' })} />
</div>

<style is:global>
  .nurbi-stage {
    position: relative;
    width: 100%;
    max-width: 560px;
    aspect-ratio: 1;
    margin-inline: auto;
    border-radius: var(--r-xl);
    /* a blank page: a faint dot grid */
    background:
      radial-gradient(color-mix(in srgb, var(--ink) 14%, transparent) 1px, transparent 1.5px) 0 0 / 22px
        22px,
      var(--tint);
    overflow: hidden;
    transition: background-color 0.4s var(--ease);
  }

  /* Delays live only on the way in (the at-N and now-N rules): scrolling back
     changes the drawing at once, so nothing lingers from a later chapter. */
  .nurbi-stage .layer {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    margin: 0;
    opacity: 0;
    /* a picture only: hidden layers must not catch the pointer or show titles */
    pointer-events: none;
    transition: opacity 0.4s var(--ease);
  }

  .nurbi-stage .layer svg {
    display: block;
    width: 100%;
    height: auto;
  }

  /* which layer shows when */
  .nurbi-stage .drawing {
    opacity: 1;
  }

  .nurbi-stage.at-3 .drawing {
    opacity: 0;
  }

  .nurbi-stage.now-3 .flicker,
  .nurbi-stage.now-4 .settled,
  .nurbi-stage.now-5 .family,
  .nurbi-stage.now-6 .result {
    opacity: 1;
  }

  /* I. one curve draws itself, then its two handles; the curve fades, they stay */
  .nurbi-stage .first-curve {
    transition: opacity 0.3s var(--ease);
  }

  .nurbi-stage .first-curve path {
    fill: none;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    stroke-linecap: butt;
  }

  .nurbi-stage .first-curve .stroke {
    stroke: var(--ink);
    stroke-width: 4;
  }

  .nurbi-stage .first-curve .arm {
    stroke: #ff2f6e;
    stroke-width: 3;
  }

  .nurbi-stage .first-curve .knob {
    fill: #ff2f6e;
    opacity: 0;
  }

  .nurbi-stage.at-1 .first-curve .stroke {
    animation: nurbi-draw-then-dim 3s var(--ease) both;
  }

  .nurbi-stage.at-1 .first-curve .arm {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 0.6s var(--ease) 1.1s;
  }

  .nurbi-stage.at-1 .first-curve .knob {
    opacity: 1;
    transition: opacity 0.3s var(--ease) 1.6s;
  }

  @keyframes nurbi-draw-then-dim {
    0% {
      stroke-dashoffset: 1;
      opacity: 1;
    }
    45% {
      stroke-dashoffset: 0;
      opacity: 1;
    }
    100% {
      stroke-dashoffset: 0;
      opacity: 0.16;
    }
  }

  /* II. the handles become his antennae; a sketch of him draws in, line after
     line, his outline is traced over it, the sketch fades and he fills in */
  .nurbi-stage.at-2 .first-curve {
    opacity: 0;
    transition: opacity 0.4s var(--ease);
  }

  .nurbi-stage .handles {
    opacity: 0;
  }

  .nurbi-stage.at-2 .handles {
    opacity: 1;
    transition: opacity 0.5s var(--ease) 0.2s;
  }

  /* widths in his own drawing units, which the stored art scales up about 7.7 times */
  .nurbi-stage .sketch path {
    fill: none;
    stroke: var(--muted);
    stroke-width: 0.16;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    stroke-linecap: butt;
  }

  .nurbi-stage.at-2 .sketch path {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 0.8s var(--ease) calc(0.3s + var(--i) * 0.09s);
  }

  .nurbi-stage.at-2 .sketch {
    animation: nurbi-fade-out 0.7s var(--ease) 2.8s both;
  }

  .nurbi-stage .trace {
    fill: none;
    stroke: var(--ink);
    stroke-width: 0.42;
    stroke-linejoin: round;
    stroke-linecap: butt;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  .nurbi-stage.at-2 .trace {
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 1.3s var(--ease) 1.5s;
    animation: nurbi-fade-out 0.5s var(--ease) 3.6s both;
  }

  /* hidden until drawn: an undrawn dash can still leave specks where arcs meet */
  .nurbi-stage .sketch path,
  .nurbi-stage .trace {
    opacity: 0;
  }

  .nurbi-stage.at-2 .sketch path,
  .nurbi-stage.at-2 .trace {
    opacity: 1;
  }

  @keyframes nurbi-fade-out {
    to {
      opacity: 0;
    }
  }

  .nurbi-stage .body,
  .nurbi-stage .face {
    opacity: 0;
  }

  .nurbi-stage.at-2 .body {
    opacity: 1;
    transition: opacity 0.7s var(--ease) 3s;
  }

  .nurbi-stage.at-2 .face {
    opacity: 1;
    transition: opacity 0.5s var(--ease) 3.5s;
  }

  /* III. one shape at a time, switched by the page; no fade, it flickers */
  .nurbi-stage .flicker span {
    grid-area: 1 / 1;
    width: 100%;
    opacity: 0;
    line-height: 0;
  }

  .nurbi-stage .flicker span.on {
    opacity: 1;
  }

  /* IV. one name holds one shape */
  .nurbi-stage .settled {
    align-content: center;
    gap: 4px;
  }

  .nurbi-stage .settled span {
    width: 78%;
    justify-self: center;
    line-height: 0;
  }

  .nurbi-stage .settled figcaption {
    justify-self: center;
    font: 700 16px / 1 var(--text);
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 8px 16px;
  }

  /* V. the kin */
  .nurbi-stage .family {
    grid-template-columns: repeat(4, 1fr);
    align-content: center;
    gap: 6%;
    padding: 10%;
  }

  .nurbi-stage .family span {
    line-height: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .nurbi-stage,
    .nurbi-stage * {
      transition-delay: 0s !important;
      animation-delay: 0s !important;
    }
  }
</style>
