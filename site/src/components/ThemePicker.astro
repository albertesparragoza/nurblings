---
// The avatar colour switcher. `pill` is one row with the name of the theme in
// use; `rows` stacks one group per row for narrow panels, where the panel's
// own label carries the name.
import { themeIds } from '../lib/themes'
import ThemeChip from './ThemeChip.astro'

interface Props {
  layout?: 'pill' | 'rows'
}

const { layout = 'pill' } = Astro.props
const groups = [
  ['Original', ['default']],
  ['Soft', themeIds('pastel')],
  ['Vivid', themeIds('bold')],
] as const
---

{
  layout === 'rows' ? (
    <div class="picker picker-rows" role="group" aria-label="Avatar colours">
      {groups.map(([label, ids]) => (
        <div class="picker-group">
          <span>{label}</span>
          <div class="picker-chips">
            {ids.map((id) => (
              <ThemeChip id={id} />
            ))}
          </div>
        </div>
      ))}
    </div>
  ) : (
    <div class="picker" role="group" aria-label="Avatar colours">
      {/* one row on wide screens; on phones, a scroller */}
      <div class="picker-scroll">
        {groups.map(([label, ids], i) => (
          <Fragment>
            {i > 0 && <span>{label}</span>}
            {ids.map((id) => (
              <ThemeChip id={id} />
            ))}
          </Fragment>
        ))}
      </div>
    </div>
  )
}
