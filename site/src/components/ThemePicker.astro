---
// The avatar colour switcher: each chip is a tiny Nurbling in that theme, and
// the name of the one in use stays visible.
import { THEMES, themeIds } from '../lib/themes'

const groups = [
  ['Original', ['default']],
  ['Soft', themeIds('pastel')],
  ['Vivid', themeIds('bold')],
] as const
---

<div class="picker" role="group" aria-label="Avatar colours">
  <b class="picker-name" data-theme-name>{THEMES.default?.label}</b>
  {
    groups.map(([label, ids]) => (
      <Fragment>
        <span>{label}</span>
        {ids.map((id) => (
          <button
            type="button"
            class="chip"
            data-theme-chip={id}
            aria-pressed={String(id === 'default')}
            aria-label={`${THEMES[id]?.label} colours`}
            title={THEMES[id]?.label}
            set:html={THEMES[id]?.render('nurbling', { size: 30, background: 'circle', animate: false })}
          />
        ))}
      </Fragment>
    ))
  }
</div>
