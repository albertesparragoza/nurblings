---
import Avatar from '../components/Avatar.astro'
import ThemePicker from '../components/ThemePicker.astro'
import Site from '../layouts/Site.astro'

const satellites = [
  { seed: 'grace', size: 72, x: 12, y: 18, d: 1.2, delay: 0 },
  { seed: 'linus', size: 56, x: 88, y: 14, d: 0.8, delay: 1.4 },
  { seed: 'radia', size: 64, x: 94, y: 62, d: 1.4, delay: 0.7 },
  { seed: 'hedy', size: 52, x: 70, y: 92, d: 0.9, delay: 2.1 },
  { seed: 'alan', size: 60, x: 16, y: 84, d: 1.1, delay: 1.1 },
  { seed: 'margaret', size: 48, x: 4, y: 50, d: 0.7, delay: 2.6 },
]

const team = [
  { name: 'Ada Park', seed: 'ada', role: 'Designer', on: false },
  { name: 'Grace Liu', seed: 'grace', role: 'Engineer', on: true },
  { name: 'Linus Ortega', seed: 'linus', role: 'Product', on: true },
  { name: 'Margaret Oduya', seed: 'margaret', role: 'Research', on: false },
  { name: 'Alan Reyes', seed: 'alan', role: 'Support', on: true },
  { name: 'Hedy Moreau', seed: 'hedy', role: 'Ops', on: true },
]

const rowA = [
  'barbara',
  'dennis',
  'frances',
  'ken',
  'edsger',
  'katherine',
  'tim',
  'joan',
  'guido',
  'sophie',
  'john',
  'yukihiro',
  'brendan',
  'anders',
  'rich',
  'bjarne',
]
const rowB = [
  'evelyn',
  'niklaus',
  'mary',
  'jean',
  'leslie',
  'donald',
  'shafi',
  'whitfield',
  'lynn',
  'adele',
  'kathleen',
  'annie',
  'dorothy',
  'roberta',
  'carol',
  'hal',
]

// a bare `---` line inside the frontmatter would end it for some parsers
const FENCE = '-'.repeat(3)

const frameworks = [
  {
    id: 'react',
    label: 'React and Next.js',
    install: 'npm install @nurblings/react',
    code: `import { Nurbling } from '@nurblings/react'

export function Avatar({ user }) {
  return <Nurbling seed={user.id} title={user.name} size={48} />
}`,
  },
  {
    id: 'vue',
    label: 'Vue and Nuxt',
    install: 'npm install @nurblings/vue',
    code: `<script setup>
import { Nurbling } from '@nurblings/vue'
defineProps(['user'])
</script>

<template>
  <Nurbling :seed="user.id" :title="user.name" :size="48" />
</template>`,
  },
  {
    id: 'astro',
    label: 'Astro',
    install: 'npm install @nurblings/astro',
    code: `${FENCE}
import { Nurbling } from '@nurblings/astro'
const { user } = Astro.props
${FENCE}

<Nurbling seed={user.id} title={user.name} size={48} />`,
  },
  {
    id: 'html',
    label: 'Any HTML',
    install: 'No build step',
    code: `<script type="module"
  src="https://cdn.jsdelivr.net/npm/@nurblings/element/dist/define.js/+esm"></script>

<nurbling-avatar seed="user-42" title="Ada Lovelace" size="48"></nurbling-avatar>`,
  },
  {
    id: 'js',
    label: 'JavaScript',
    install: 'npm install nurblings',
    code: `import { nurbling, toDataUri } from 'nurblings'

element.innerHTML = nurbling('user-42', { size: 48, title: 'Ada Lovelace' })
image.src = toDataUri(nurbling('user-42'))`,
  },
]

const prompt = `npx skills add albertesparragoza/nurblings

# then, in your agent
> Give every commenter an avatar.`
---

<Site class="home">
  <section class="hero wrap">
    <div class="hero-copy">
      <h1>
        <span style="--i:0">A</span> <span style="--i:1">small</span> <span style="--i:2">creature</span>{' '}
        <em><span style="--i:3">for</span> <span style="--i:4">every</span> <span style="--i:5">account</span></em>
      </h1>
      <p class="lead">
        Animated avatars that breathe, blink and wiggle their antennae. Everyone who signs up gets one of their
        own, in React, Vue, Astro or plain HTML.
      </p>
      <label class="seed-field">
        <span class="sr-only">Type a name</span>
        <input id="seed" value="ada@example.com" placeholder="Type a name" autocomplete="off" spellcheck="false" />
        <button class="btn btn-ghost" id="shuffle" type="button">Shuffle</button>
      </label>
      <div class="actions">
        <a class="btn" href="/docs/getting-started/">Get started</a>
        <a class="btn btn-ghost" href="/playground/">Open the playground</a>
        <button class="copy-chip" type="button" data-copy="npm install @nurblings/react">
          <code>npm install @nurblings/react</code><span data-copy-label>Copy</span>
        </button>
      </div>
    </div>

    <div class="stage" id="stage">
      <div class="blob" aria-hidden="true"></div>
      {
        satellites.map((s) => (
          <span class="sat" style={`--x:${s.x}%;--y:${s.y}%;--d:${s.d};--delay:${s.delay}`} aria-hidden="true">
            <Avatar seed={s.seed} size={s.size} />
          </span>
        ))
      }
      <div class="hero-tilt">
        <button class="hero-av" id="hero-av" type="button" aria-label="Boop the Nurbling" aria-describedby="bubble">
          <Avatar id="hero-avatar" seed="ada@example.com" size={320} background="none" />
        </button>
      </div>
      <span class="bubble" id="bubble" aria-live="polite"></span>
    </div>
  </section>

  <div class="picker-row">
    <ThemePicker />
  </div>

  <section class="wrap section" id="scene-section" data-reveal>
    <div class="section-head">
      <h2>At home in real products</h2>
      <p>Member lists, profiles, conversations. Pick a teammate and their avatar travels into the profile.</p>
    </div>
    <div class="panel">
      <div class="scene">
        <div class="card">
          <h3>Team</h3>
          <div id="members">
            {
              team.map((p) => (
                <button
                  class="member"
                  type="button"
                  data-seed={p.seed}
                  data-name={p.name}
                  data-role={p.role}
                  aria-current={String(p.seed === 'grace')}
                >
                  <Avatar seed={p.seed} size={44} transition={p.seed} title={p.name} />
                  <span>
                    {p.name}
                    <small>{p.role}</small>
                  </span>
                  <i class:list={['dot', { on: p.on }]} />
                </button>
              ))
            }
          </div>
        </div>
        <div class="card profile">
          <div id="profile-av"><Avatar seed="grace" size={120} transition="grace" title="Grace Liu" /></div>
          <h4 id="profile-name">Grace Liu</h4>
          <small id="profile-role">Engineer · online</small>
          <button class="btn" type="button">Message</button>
        </div>
        <div class="card chat">
          <h3>#launch</h3>
          <div id="chat">
            <div class="msg"><Avatar seed="linus" size={32} /><p>Shipping the onboarding flow today.</p></div>
            <div class="msg me"><p>On it, reviewing after lunch.</p><Avatar seed="ada" size={32} /></div>
          </div>
          <div class="msg typing-row" id="typing">
            <Avatar seed="margaret" size={32} />
            <p class="typing"><i></i><i></i><i></i></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section family" data-reveal>
    <div class="wrap section-head">
      <h2>Ten bodies, five moods, one family</h2>
      <p>Scarves, hats, badges and antennae at every angle. Each person keeps the same Nurbling wherever they show up.</p>
    </div>
    <div class="marquee" aria-hidden="true">
      <div class="track">{[...rowA, ...rowA].map((s) => <Avatar seed={s} size={76} still />)}</div>
    </div>
    <div class="marquee reverse" aria-hidden="true">
      <div class="track">{[...rowB, ...rowB].map((s) => <Avatar seed={s} size={76} still />)}</div>
    </div>
    <div class="wrap center"><a class="btn btn-ghost" href="/gallery/">See the whole family</a></div>
  </section>

  <section class="wrap section" data-reveal>
    <div class="section-head">
      <h2>The details come included</h2>
    </div>
    <div class="features">
      <article class="feature">
        <div class="feature-art">
          <Avatar seed="hopper" size={40} />
          <Avatar seed="hopper" size={64} />
          <Avatar seed="hopper" size={96} />
        </div>
        <h3>Theirs for good</h3>
        <p>The same person gets the same creature on every page and every device. Nothing to store, upload or fetch.</p>
      </article>
      <article class="feature">
        <div class="feature-art">
          <Avatar id="motion-demo" seed="lovelace" size={96} />
          <div class="toggles" id="motion-toggles">
            <button type="button" aria-pressed="true" data-layer="breath">Breath</button>
            <button type="button" aria-pressed="true" data-layer="blink">Blink</button>
            <button type="button" aria-pressed="true" data-layer="antennae">Antennae</button>
          </div>
        </div>
        <h3>Alive by default</h3>
        <p>They breathe, blink and drift in plain CSS, and hold still for anyone who prefers reduced motion.</p>
      </article>
      <article class="feature">
        <div class="feature-art glide">
          <Avatar seed="turing" size={44} />
          <svg width="56" height="16" viewBox="0 0 56 16" aria-hidden="true"><path d="M2 8h48m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path></svg>
          <Avatar seed="turing" size={96} />
        </div>
        <h3>Moves between views</h3>
        <p>An avatar glides from a list into a profile, or a card into a header, instead of jumping there.</p>
      </article>
      <article class="feature">
        <div class="feature-art"><ThemePicker /></div>
        <h3>Your colours</h3>
        <p>Ten ready themes, or two to five brand colours of your own. Faces stay readable either way.</p>
      </article>
      <article class="feature">
        <div class="feature-art modes">
          <span class="tile"><Avatar seed="radia" size={80} /></span>
          <span class="tile dark"><Avatar seed="radia" size={80} mode="dark" /></span>
        </div>
        <h3>Light and dark</h3>
        <p>Containers follow the page, and antennae stay visible on either side. One prop, no script.</p>
      </article>
      <article class="feature">
        <div class="feature-art"><span class="big-num">~8 KB</span></div>
        <h3>Light on the page</h3>
        <p>No dependencies, full TypeScript types, and server components that send no JavaScript to the browser.</p>
      </article>
    </div>
  </section>

  <section class="wrap section" data-reveal>
    <div class="section-head">
      <h2>Works where you build</h2>
      <p>A component for React, Vue and Astro, and one HTML tag for everything else.</p>
    </div>
    <div class="tabs" role="tablist" aria-label="Framework">
      {
        frameworks.map((f, i) => (
          <button type="button" role="tab" id={`tab-${f.id}`} aria-selected={String(i === 0)} aria-controls={`panel-${f.id}`} data-tab={f.id}>
            {f.label}
          </button>
        ))
      }
    </div>
    {
      frameworks.map((f, i) => (
        <div class="code-card" role="tabpanel" id={`panel-${f.id}`} aria-labelledby={`tab-${f.id}`} data-panel={f.id} hidden={i !== 0}>
          <div class="code-head">
            <span>{f.install}</span>
            <button type="button" data-copy={f.code}>
              <span data-copy-label>Copy</span>
            </button>
          </div>
          <pre><code>{f.code}</code></pre>
        </div>
      ))
    }
  </section>

  <section class="wrap section" data-reveal>
    <div class="ai-band">
      <div>
        <h2>Your agent can add them</h2>
        <p>Install the Nurblings skill once, then ask for avatars in plain words.</p>
        <div class="actions">
          <a class="btn" href="/ai/">Get the skill</a>
        </div>
      </div>
      <div class="ai-prompt">
        <div class="code-head">
          <span>Terminal</span>
          <button type="button" data-copy={prompt}><span data-copy-label>Copy</span></button>
        </div>
        <pre data-origin>{prompt}</pre>
      </div>
    </div>
  </section>

  <section class="wrap section cta" data-reveal>
    <h2>Hatch your first one</h2>
    <div class="actions">
      <a class="btn" href="/docs/getting-started/">Get started</a>
      <a class="btn btn-ghost" href="/playground/">Open the playground</a>
    </div>
    <div class="cta-row">
      {['you', 'your-team', 'your-users', 'everyone', 'hello', 'world', 'nurbling'].map((s, i) => <span style={`--i:${i}`}><Avatar seed={s} size={64} /></span>)}
    </div>
  </section>
</Site>

<script>
  import { morph } from 'nurblings/transition'
  import { reducedMotion, repaint } from '../lib/client'
  import { tabs } from '../lib/tabs'

  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T
  // read live: the preference can change while the page is open
  const reduce = reducedMotion
  const NAMES = ['ada@example.com', 'grace', 'linus', 'katherine', 'margaret', 'dennis', 'radia', 'barbara', 'frances', 'hedy', 'alan', 'joan', 'tim', 'guido', 'sophie', 'anders', 'yukihiro']
  const pick = <T,>(list: readonly T[]) => list[Math.floor(Math.random() * list.length)] as T
  const spring = 'cubic-bezier(.34,1.56,.64,1)'
  const inView = new Set<Element>()
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) e.isIntersecting ? inView.add(e.target) : inView.delete(e.target)
  })

  // hero: type a seed, shuffle, boop
  const seed = $<HTMLInputElement>('seed')
  const hero = $('hero-avatar')
  const heroButton = $('hero-av')
  const pop = (el: Element | null) =>
    !reduce() &&
    el?.animate(
      [{ transform: 'scale(1)' }, { transform: 'scale(.9,1.08)' }, { transform: 'scale(1.05,.96)' }, { transform: 'scale(1)' }],
      { duration: 560, easing: spring },
    )
  const setHero = (value: string) => {
    hero.dataset.seed = value || ' '
    hero.dataset.title = value || 'Nurbling'
    repaint(hero)
  }
  seed.addEventListener('input', () => setHero(seed.value))
  $('shuffle').addEventListener('click', () => {
    seed.value = pick(NAMES.filter((n) => n !== seed.value))
    setHero(seed.value)
    pop(heroButton)
  })

  // a speech bubble asks for the first click, then carries the replies
  const MOODS = ['curious', 'pleased', 'thinking', 'sleepy', 'neutral'] as const
  const LINES = ['hi', 'oh', 'hmm', 'zzz', 'hey']
  let boops = 0
  const bubble = $('bubble')
  let hide = 0
  const say = (text: string, hold = 0) => {
    bubble.textContent = text
    bubble.classList.add('on')
    clearTimeout(hide)
    if (hold) hide = window.setTimeout(() => bubble.classList.remove('on'), hold)
  }
  const ask = window.setTimeout(() => {
    say(matchMedia('(pointer: coarse)').matches ? 'Tap me' : 'Click me')
    heroButton.classList.add('beckon')
  }, reduce() ? 0 : 600)
  heroButton.addEventListener('click', () => {
    clearTimeout(ask)
    heroButton.classList.remove('beckon')
    const i = boops++ % MOODS.length
    hero.dataset.mood = MOODS[i]
    repaint(hero)
    pop(heroButton)
    say(LINES[i] ?? '', 1600)
  })

  // the stage leans toward the pointer; satellites drift at their own depth
  const stage = $('stage')
  io.observe(stage)
  // only a mouse leans the stage: touch scrolling should not move it
  const fine = matchMedia('(hover: hover) and (pointer: fine)')
  {
    let tx = 0
    let ty = 0
    let x = 0
    let y = 0
    let raf = 0
    const tick = () => {
      x += (tx - x) * 0.07
      y += (ty - y) * 0.07
      stage.style.setProperty('--px', x.toFixed(4))
      stage.style.setProperty('--py', y.toFixed(4))
      raf = Math.abs(tx - x) + Math.abs(ty - y) > 0.0005 ? requestAnimationFrame(tick) : 0
    }
    addEventListener(
      'pointermove',
      (e) => {
        if (reduce() || !fine.matches || !inView.has(stage)) return
        tx = e.clientX / innerWidth - 0.5
        ty = e.clientY / innerHeight - 0.5
        if (!raf) raf = requestAnimationFrame(tick)
      },
      { passive: true },
    )

    // switching reduced motion on mid-visit stops the scripted motion too;
    // the CSS animations already stop through the stylesheet
    matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change', (e) => {
      if (!e.matches) return
      tx = ty = x = y = 0
      stage.style.setProperty('--px', '0')
      stage.style.setProperty('--py', '0')
      for (const a of document.getAnimations()) if (a.constructor === Animation) a.cancel()
    })

    // satellites keep hatching new faces
    const sats = [...document.querySelectorAll<HTMLElement>('.sat [data-av]')]
    let next = 0
    setInterval(() => {
      if (reduce() || document.hidden || !inView.has(stage) || sats.length === 0) return
      const el = sats[next++ % sats.length] as HTMLElement
      el.dataset.seed = `${pick(NAMES)}-${Math.floor(Math.random() * 1000)}`
      repaint(el)
      el.firstElementChild?.animate(
        [{ transform: 'scale(.2)', opacity: 0 }, { transform: 'scale(1.12)', opacity: 1, offset: 0.7 }, { transform: 'scale(1)' }],
        { duration: 640, easing: spring },
      )
    }, 2400)
  }

  // the scene: click a teammate, or watch it run on its own
  const members = $('members')
  const scene = $('scene-section')
  io.observe(scene)
  let selected = 'grace'
  // once a visitor picks someone, the scene stops running on its own
  let touched = false
  const select = (button: HTMLElement) => {
    if (button.dataset.seed === selected) return
    morph(() => {
      selected = button.dataset.seed ?? ''
      const av = $('profile-av').querySelector<HTMLElement>('[data-av]')
      if (av) {
        av.dataset.seed = selected
        av.dataset.transition = selected
        av.dataset.title = button.dataset.name
        repaint(av)
      }
      $('profile-name').textContent = button.dataset.name ?? ''
      const online = button.querySelector('.dot')?.classList.contains('on')
      $('profile-role').textContent = `${button.dataset.role} · ${online ? 'online' : 'away'}`
      for (const m of members.children) m.setAttribute('aria-current', String(m === button))
    })
  }
  members.addEventListener('click', (e) => {
    const button = (e.target as Element).closest<HTMLElement>('.member')
    if (!button) return
    touched = true
    select(button)
  })

  const SCRIPT = [
    { seed: 'linus', text: 'Shipping the onboarding flow today.' },
    { seed: 'ada', text: 'On it, reviewing after lunch.', me: true },
    { seed: 'margaret', text: 'Research notes are in the doc.' },
    { seed: 'alan', text: 'Support queue is clear.' },
    { seed: 'hedy', text: 'Deploy is green.' },
    { seed: 'grace', text: 'Reviewing now.' },
  ]
  const chat = $('chat')
  const typing = $('typing')
  const typingAv = typing.querySelector<HTMLElement>('[data-av]')
  // the first two lines are rendered on the server, so nothing grows after load
  let line = 2
  const post = (animate: boolean) => {
    const m = SCRIPT[line++ % SCRIPT.length] as (typeof SCRIPT)[number]
    const row = document.createElement('div')
    row.className = `msg${m.me ? ' me' : ''}${animate ? ' new' : ''}`
    const av = document.createElement('span')
    Object.assign(av.dataset, { av: '', seed: m.seed, size: '32', bg: 'circle', title: m.seed })
    av.className = 'av'
    repaint(av)
    const p = document.createElement('p')
    p.textContent = m.text
    row.append(...(m.me ? [p, av] : [av, p]))
    chat.append(row)
    while (chat.children.length > 3) chat.firstElementChild?.remove()
    const upcoming = SCRIPT[line % SCRIPT.length]
    if (typingAv && upcoming) {
      typingAv.dataset.seed = upcoming.seed
      repaint(typingAv)
      typing.classList.toggle('me', Boolean(upcoming.me))
    }
  }

  {
    let beat = 0
    setInterval(() => {
      if (reduce() || document.hidden || !inView.has(scene) || touched) return
      beat++
      post(true)
      const dots = members.querySelectorAll('.dot')
      dots[Math.floor(Math.random() * dots.length)]?.classList.toggle('on')
      if (beat % 2 === 0) {
        const buttons = [...members.querySelectorAll<HTMLElement>('.member')]
        const i = buttons.findIndex((b) => b.dataset.seed === selected)
        const nextButton = buttons[(i + 1) % buttons.length]
        if (nextButton) select(nextButton)
      }
    }, 3200)
  }

  // feature: motion layers
  const motionDemo = $('motion-demo')
  const layers = { breath: true, blink: true, antennae: true }
  $('motion-toggles').addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLElement>('[data-layer]')
    if (!b) return
    const key = b.dataset.layer as keyof typeof layers
    layers[key] = !layers[key]
    b.setAttribute('aria-pressed', String(layers[key]))
    motionDemo.dataset.motion = JSON.stringify(layers)
    repaint(motionDemo)
  })

  // framework tabs
  const tablist = document.querySelector<HTMLElement>('.home [role="tablist"]')
  if (tablist) {
    tabs(tablist, (tab) => {
      for (const p of document.querySelectorAll<HTMLElement>('[data-panel]')) p.hidden = p.dataset.panel !== tab.dataset.tab
    })
  }
</script>

<style is:global>
  .home .hero {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
    min-height: calc(100svh - 68px - 96px);
    padding-block: 24px;
  }

  .home h1 {
    font-size: clamp(48px, 6.6vw, 96px);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 0.95;
  }

  .home h1 em {
    display: block;
    text-wrap: balance;
    font-style: normal;
    color: var(--accent-text);
    transition: color 0.4s var(--ease);
  }

  .home h1 span {
    display: inline-block;
    animation: nb-rise 0.7s var(--ease) both;
    animation-delay: calc(var(--i) * 45ms);
  }

  @keyframes nb-rise {
    from {
      opacity: 0;
      transform: translateY(0.55em) rotate(5deg);
    }
  }


  .seed-field {
    display: flex;
    gap: 8px;
    align-items: center;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 18px;
    padding: 6px 6px 6px 18px;
    max-width: 480px;
    margin: 28px 0 18px;
    transition: border-color 0.2s;
  }

  .seed-field:focus-within {
    border-color: var(--accent);
  }

  .seed-field input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    font-size: 18px;
    font-weight: 500;
    outline: none;
  }

  .stage {
    --px: 0;
    --py: 0;
    position: relative;
    aspect-ratio: 1;
    width: 100%;
    max-width: 560px;
    justify-self: center;
