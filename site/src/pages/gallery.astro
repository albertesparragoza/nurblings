---
import { nurbling, SHELLS, SILHOUETTES } from 'nurblings'
import Avatar from '../components/Avatar.astro'
import ThemeChip from '../components/ThemeChip.astro'
import ThemePicker from '../components/ThemePicker.astro'
import Site from '../layouts/Site.astro'

// every discrete choice a seed makes; the smooth variations come on top
const colourPairs = Object.values(SHELLS).reduce(
  (sum, s) => sum + s.accents.length * (s.accents.length - 1),
  0,
)
const combinations =
  Object.keys(SILHOUETTES).length *
  colourPairs *
  5 * // moods
  3 * // mouths
  4 * // extras
  4 * // eye shapes
  4 * // brows
  13 * // brow tilts
  2 * // one or two antennae
  5 // antenna bends
const millions = Math.floor(combinations / 1_000_000)

const tiny = (seed: string, opts: Parameters<typeof nurbling>[1]) =>
  nurbling(seed, { size: 30, background: 'circle', animate: false, frame: 'portrait', ...opts })
const lenses = [
  {
    key: 'silhouette',
    label: 'Body',
    options: Object.keys(SILHOUETTES).map((name) => ({
      value: name,
      art: tiny(`body-${name}`, { silhouette: name as keyof typeof SILHOUETTES, frame: 'full' }),
    })),
  },
  {
    key: 'mood',
    label: 'Mood',
    options: (['neutral', 'curious', 'pleased', 'thinking', 'sleepy'] as const).map((mood) => ({
      value: mood,
      art: tiny('mood-grace', { mood }),
    })),
  },
  {
    key: 'extra',
    label: 'Wearing',
    options: (['none', 'scarf', 'hat', 'collar'] as const).map((extra) => ({
      value: extra,
      art: tiny('wear-linus', { extra, frame: 'full' }),
    })),
  },
]
const EIGHT = ['ada', 'grace', 'linus', 'margaret', 'alan', 'hedy', 'radia', 'ken']
const THEME_IDS = [
  'default',
  'lagoon',
  'punch',
  'candy',
  'picnic',
  'sorbet',
  'terracotta',
  'marble',
  'riso',
  'lime',
  'bauhaus',
]
---

<Site title="Gallery" active="/gallery/" class="gal">
  <section class="wrap crowd-head">
    <h1>Meet the family</h1>
    <p class="lead">
      {millions} million combinations of body, face and colour, and every name adds its own small twist. Pick
      any face to meet it.
    </p>
  </section>

  <section class="wrap crowd-section" id="crowd-section" aria-labelledby="crowd-status">
    <div class="crowd-bar">
      <p class="crowd-status" id="crowd-status" aria-live="polite">Crowd 001</p>
      <button type="button" class="btn btn-ghost" id="another">Another crowd</button>
    </div>
    <div class="crowd" id="crowd"></div>
  </section>

  <nav class="lens-pill" id="lens-pill" aria-label="Lenses">
    {
      lenses.map((l) => (
        <button type="button" class="lens" popovertarget={`lens-${l.key}`} data-lens-button={l.key}>
          <span class="lens-label">{l.label}</span>
          <b class="lens-value" data-lens-value={l.key}>Any</b>
        </button>
      ))
    }
    <button type="button" class="lens" popovertarget="lens-theme">
      <span class="lens-label">Colours</span>
      <b class="lens-value" data-theme-name>Original</b>
    </button>
    <button type="button" class="lens lens-clear" id="lens-clear" aria-label="Clear lenses" hidden>
      Clear
    </button>
  </nav>

  {
    lenses.map((l) => (
      <div class="lens-panel" id={`lens-${l.key}`} popover>
        <p class="lens-title">{l.label}</p>
        <div class="lens-options">
          <button type="button" class="lchip any" data-lens={l.key} data-v="" aria-pressed="true">
            Any
          </button>
          {l.options.map((o) => (
            <button type="button" class="lchip" data-lens={l.key} data-v={o.value} aria-pressed="false">
              <span class="lchip-art" set:html={o.art} />
              <span>{o.value === 'none' ? 'nothing' : o.value}</span>
            </button>
          ))}
        </div>
      </div>
    ))
  }
  <div class="lens-panel" id="lens-theme" popover>
    <p class="lens-title">Colours</p>
    <div class="lens-options">{THEME_IDS.map((id) => <ThemeChip id={id} />)}</div>
  </div>

  <section id="colours" class="wrap section colours">
    <h2>Same eight, every colour</h2>
    <p class="lead">Ten themes, one prop each. The faces stay put while the colours change.</p>
    <ThemePicker />
    <div class="eight">{EIGHT.map((s) => <Avatar seed={s} size={104} title={s} />)}</div>
    <div class="actions">
      <button class="copy-chip" type="button" id="theme-snippet" data-copy="<Nurbling seed={user.id} />">
        <code id="theme-snippet-code">{'<Nurbling seed={user.id} />'}</code>
        <span data-copy-label>Copy</span>
      </button>
      <a class="btn btn-ghost" id="theme-play" href="/playground/">Open in the playground</a>
    </div>
  </section>

  <dialog class="meet" id="meet" aria-labelledby="meet-name">
    <div class="meet-av" id="meet-av"></div>
    <h2 id="meet-name">ada</h2>
    <p class="meet-traits" id="meet-traits"></p>
    <div class="actions">
      <button class="copy-chip" type="button" id="meet-copy" data-copy="">
        <code id="meet-code"></code><span data-copy-label>Copy</span>
      </button>
      <a class="btn" id="meet-play" href="/playground/">Open in the playground</a>
      <button type="button" class="btn btn-ghost" id="meet-close">Close</button>
    </div>
  </dialog>
</Site>

<script>
  import { SILHOUETTES, traits } from 'nurblings'
  import { morph } from 'nurblings/transition'
  import { applyTheme, currentTheme, reducedMotion, theme } from '../lib/client'

  type Lens = 'silhouette' | 'mood' | 'extra'
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T
  const NAMES = ['ada', 'grace', 'linus', 'margaret', 'alan', 'hedy', 'radia', 'ken', 'joan', 'tim', 'frances', 'dennis', 'barbara', 'edsger', 'katherine', 'guido', 'sophie', 'anders', 'mary', 'jean', 'leslie', 'donald', 'shafi', 'lynn', 'adele', 'annie', 'dorothy', 'roberta', 'carol', 'hal', 'evelyn', 'niklaus']
  // a phone gets a smaller crowd; the grid keeps its size while it fills
  const SIZE = innerWidth < 720 ? 120 : 240
  // how far a search looks before it settles for what it found
  const LIMIT = 1_000_000
  const pins: Record<Lens, string> = { silhouette: '', mood: '', extra: '' }
  let crowdNo = 1

  const crowd = $('crowd')
  const status = $('crowd-status')
  const seedAt = (k: number) => `${NAMES[k % NAMES.length]}-${Math.floor(k / NAMES.length) + 1}`
  const count = (n: number) => n.toLocaleString('en-US')
  const pad = (n: number) => String(n).padStart(3, '0')

  // the body a seed drew: the preset with the same plates and the nearest proportions
  const presets = Object.entries(SILHOUETTES)
  const bodyOf = (t: ReturnType<typeof traits>) => {
    const s = t.silhouette
    let best = ''
    let gap = Number.POSITIVE_INFINITY
    for (const [name, p] of presets) {
      if (p.rows !== s.rows || p.cols !== s.cols || (p.plates ?? 'crown') !== (s.plates ?? 'crown')) continue
      const d = Math.abs(p.hw - s.hw) + Math.abs((p.width ?? 1) - (s.width ?? 1))
      if (d < gap) [best, gap] = [name, d]
    }
    return best
  }
  const matches = (seed: string) => {
    const t = traits(seed)
    return (
      (!pins.mood || t.mood === pins.mood) &&
      (!pins.extra || t.extra === pins.extra) &&
      (!pins.silhouette || bodyOf(t) === pins.silhouette)
    )
  }

  // a fixed grid of cells, filled as the search finds its crowd
  const cells: HTMLButtonElement[] = []
  for (let i = 0; i < SIZE; i++) {
    const cell = document.createElement('button')
    cell.type = 'button'
    cell.className = 'cell'
    crowd.append(cell)
    cells.push(cell)
  }
  const draw = (cell: HTMLElement, seed: string, transition?: string) => {
    cell.innerHTML = theme().render(seed, {
      size: 56,
      background: 'circle',
      animate: false,
      title: seed,
      ...(transition ? { transition } : {}),
    })
  }
  const fill = (cell: HTMLButtonElement, seed: string) => {
    cell.dataset.seed = seed
    cell.setAttribute('aria-label', `Meet ${seed}`)
    cell.disabled = false
    draw(cell, seed)
  }
  const empty = (cell: HTMLButtonElement) => {
    delete cell.dataset.seed
    cell.removeAttribute('aria-label')
    cell.disabled = true
    cell.innerHTML = ''
  }

  let run = 0
  const search = async () => {
    const mine = ++run
    const lensed = Boolean(pins.silhouette || pins.mood || pins.extra)
    for (const cell of cells) empty(cell)
    const skip = (crowdNo - 1) * SIZE
    let found = 0
    let matched = 0
    let k = lensed ? 0 : skip
    const label = `Crowd ${pad(crowdNo)}`
    while (found < SIZE && k < LIMIT) {
      // short slices, so typing, scrolling and new choices never wait on the search
      const until = performance.now() + 8
      while (found < SIZE && k < LIMIT && performance.now() < until) {
        const seed = seedAt(k++)
        if (lensed && (!matches(seed) || matched++ < skip)) continue
        fill(cells[found++] as HTMLButtonElement, seed)
      }
      status.textContent = lensed ? `${label} · found ${count(found)} in ${count(k)} names` : `${label} · ${count(found)} Nurblings`
      await new Promise((r) => setTimeout(r, 0))
      if (mine !== run) return
    }
    if (lensed) {
      status.textContent =
        found < SIZE
          ? `${label} · a rare mix: ${count(found)} in the first ${count(k)} names`
          : `${label} · found ${count(found)} in ${count(k)} names`
    }
  }

  // lenses, the crowd number and the theme live in the address, so a crowd can be shared
  const save = () => {
    const p = new URLSearchParams()
    if (crowdNo > 1) p.set('crowd', String(crowdNo))
    for (const [k, v] of Object.entries(pins)) if (v) p.set(k, v)
    if (currentTheme() !== 'default') p.set('theme', currentTheme())
    history.replaceState(null, '', p.size ? `#${p}` : location.pathname)
  }
  const showLenses = () => {
    for (const key of Object.keys(pins) as Lens[]) {
      const v = pins[key]
      const el = document.querySelector(`[data-lens-value="${key}"]`)
      if (el) el.textContent = v ? (v === 'none' ? 'nothing' : v) : 'Any'
      for (const chip of document.querySelectorAll<HTMLElement>(`[data-lens="${key}"]`)) {
        chip.setAttribute('aria-pressed', String(chip.dataset.v === v))
      }
    }
    $('lens-clear').hidden = !(pins.silhouette || pins.mood || pins.extra)
  }

  {
    const p = new URLSearchParams(location.hash.slice(1))
    crowdNo = Math.max(1, Number(p.get('crowd')) || 1)
    for (const key of Object.keys(pins) as Lens[]) pins[key] = p.get(key) ?? ''
    const linked = p.get('theme')
    if (linked) applyTheme(linked)
  }
  showLenses()
  void search()

  document.addEventListener('click', (e) => {
    const chip = (e.target as Element).closest<HTMLElement>('[data-lens]')
    if (!chip) return
    pins[chip.dataset.lens as Lens] = chip.dataset.v ?? ''
    crowdNo = 1
    chip.closest<HTMLElement>('[popover]')?.hidePopover()
    showLenses()
    save()
    void search()
  })
  $('lens-clear').addEventListener('click', () => {
    pins.silhouette = pins.mood = pins.extra = ''
    crowdNo = 1
    showLenses()
    save()
    void search()
  })
  $('another').addEventListener('click', () => {
    crowdNo++
    save()
    void search()
  })

  // a new theme recolours the same crowd in place, a slice at a time
  let paintRun = 0
  const snippet = $('theme-snippet')
  document.addEventListener('nb-theme', async () => {
    const id = currentTheme()
    const code = id === 'default' ? '<Nurbling seed={user.id} />' : `<Nurbling seed={user.id} theme="${id}" />`
    snippet.dataset.copy = code
    $('theme-snippet-code').textContent = code
    $<HTMLAnchorElement>('theme-play').href = id === 'default' ? '/playground/' : `/playground/#theme=${id}`
    for (const panel of document.querySelectorAll<HTMLElement>('#lens-theme:popover-open')) panel.hidePopover()
    save()
    const mine = ++paintRun
    for (let i = 0; i < cells.length; i += 60) {
      for (const cell of cells.slice(i, i + 60)) if (cell.dataset.seed) draw(cell, cell.dataset.seed)
      await new Promise((r) => requestAnimationFrame(r))
      if (mine !== paintRun) return
    }
  })

  // the lens pill shows only while the crowd is on screen
  const pill = $('lens-pill')
  // the grid itself, less a strip at the bottom: the pill leaves before the colours section arrives
  new IntersectionObserver(([entry]) => pill.classList.toggle('show', Boolean(entry?.isIntersecting)), {
    rootMargin: '-120px 0px -140px 0px',
  }).observe(crowd)

  // meet one: the face glides from the crowd into the dialog and back
  const meet = $<HTMLDialogElement>('meet')
  let from: HTMLButtonElement | null = null
  const describe = (seed: string) => {
    const t = traits(seed)
    return [bodyOf(t), t.mood, t.extra === 'none' ? '' : `wearing a ${t.extra}`].filter(Boolean).join(' · ')
  }
  crowd.addEventListener('click', async (e) => {
    const cell = (e.target as Element).closest<HTMLButtonElement>('.cell')
    const seed = cell?.dataset.seed
    if (!cell || !seed) return
    from = cell
    const id = currentTheme()
    const code = id === 'default' ? `<Nurbling seed="${seed}" />` : `<Nurbling seed="${seed}" theme="${id}" />`
    $('meet-name').textContent = seed
    $('meet-traits').textContent = describe(seed)
    $('meet-code').textContent = code
    $('meet-copy').dataset.copy = code
    const link = new URLSearchParams({ seed })
    if (id !== 'default') link.set('theme', id)
    $<HTMLAnchorElement>('meet-play').href = `/playground/#${link}`
    draw(cell, seed, 'meet')
    await morph(() => {
      draw(cell, seed)
      $('meet-av').innerHTML = theme().render(seed, { size: 220, frame: 'full', title: seed, transition: 'meet' })
      meet.showModal()
    })
  })
  const close = async () => {
    const cell = from
    const seed = cell?.dataset.seed
    if (!cell || !seed || reducedMotion()) {
      meet.close()
      return
    }
    await morph(() => {
      $('meet-av').innerHTML = ''
      meet.close()
      draw(cell, seed, 'meet')
    })
    draw(cell, seed)
    cell.focus()
  }
  $('meet-close').addEventListener('click', close)
  meet.addEventListener('cancel', (e) => {
    e.preventDefault()
    void close()
  })
  meet.addEventListener('click', (e) => {
    if (e.target === meet) void close()
  })
</script>

<style is:global>
  .gal .crowd-head {
    padding-block: clamp(28px, 5vw, 56px) 8px;
    max-width: 760px;
    margin-left: max(var(--gutter), calc((100% - var(--maxw)) / 2));
  }

  .gal .crowd-head h1 {
    font-size: clamp(36px, 4.4vw, 56px);
    font-weight: 800;
    letter-spacing: -0.035em;
  }

  .gal .crowd-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    margin: 18px 0 14px;
  }

  .gal .crowd-status {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  .gal .crowd {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(56px, 1fr));
    gap: 10px 8px;
    justify-items: center;
  }

  /* room for the pill under the last row */
  .gal .crowd-section {
    padding-bottom: 96px;
  }

  .gal .cell {
    width: 56px;
    height: 56px;
    border: 0;
    padding: 0;
    border-radius: 50%;
    line-height: 0;
    background: var(--tint);
    transition: transform 0.25s var(--spring);
  }

  .gal .cell:disabled {
    cursor: default;
    opacity: 0.45;
  }

  .gal .cell:not(:disabled):hover,
  .gal .cell:focus-visible {
    transform: scale(1.2);
  }

  /* the lens pill: small, at thumb height, only while the crowd is on screen */
  .gal .lens-pill {
    position: fixed;
    left: 50%;
    bottom: 16px;
    z-index: 25;
    display: flex;
    gap: 4px;
    max-width: calc(100vw - 32px);
    overflow-x: auto;
    scrollbar-width: none;
    padding: 6px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 999px;
    box-shadow: 0 16px 40px -20px rgb(0 0 0 / 0.45);
    opacity: 0;
    visibility: hidden;
    transform: translate(-50%, 12px);
    transition:
      opacity 0.2s var(--ease),
      transform 0.2s var(--ease),
      visibility 0.2s;
  }

  .gal .lens-pill.show {
    opacity: 1;
    visibility: visible;
    transform: translate(-50%, 0);
  }

  .gal .lens {
    flex: none;
    display: grid;
    gap: 1px;
    text-align: left;
    border: 0;
    background: none;
    border-radius: 999px;
    padding: 6px 14px;
    line-height: 1.1;
  }

  .gal .lens:hover {
    background: var(--tint);
  }

  .gal .lens-label {
    font-size: 11px;
    font-weight: 600;
    color: var(--muted);
  }

  .gal .lens-value {
    font-size: 14px;
    text-transform: capitalize;
    white-space: nowrap;
  }

  .gal .lens[hidden] {
    display: none;
  }

  .gal .lens-value[data-theme-name] {
    text-transform: none;
  }

  .gal .lens-clear {
    align-self: center;
    font-weight: 700;
    color: var(--accent-text);
  }

  .gal .lens-panel {
    position: fixed;
    inset: auto auto 84px 50%;
    translate: -50% 0;
    margin: 0;
    width: min(620px, calc(100vw - 32px));
    padding: 14px;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--surface);
    color: var(--ink);
    box-shadow: 0 24px 60px -28px rgb(0 0 0 / 0.5);
  }

  .gal .lens-title {
    margin: 0 0 10px;
    font-size: 12px;
    font-weight: 700;
    color: var(--muted);
  }

  .gal .lens-options {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .gal .lchip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 40px;
    border: 1px solid var(--line);
    background: var(--surface);
    border-radius: 999px;
    padding: 2px 12px 2px 3px;
    font-size: 13px;
    font-weight: 600;
    line-height: 1;
    text-transform: capitalize;
  }

  .gal .lchip.any {
    padding: 2px 14px;
  }

  .gal .lchip-art {
    line-height: 0;
  }

  .gal .lchip:hover {
    border-color: var(--accent);
  }

  .gal .lchip[aria-pressed='true'] {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 14%, var(--surface));
  }

  .gal .colours h2 {
    font-size: clamp(34px, 4vw, 52px);
    font-weight: 800;
  }

  .gal .colours .lead {
    margin-bottom: 22px;
  }

  .gal .eight {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px;
    margin: 28px 0 22px;
  }

  .gal .meet {
    width: min(420px, calc(100vw - 32px));
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    background: var(--surface);
    color: var(--ink);
    text-align: center;
  }

  .gal .meet::backdrop {
    background: rgb(20 16 32 / 0.45);
  }

  .gal .meet-av {
    line-height: 0;
    min-height: 220px;
  }

  .gal .meet-av svg {
    width: min(220px, 60vw);
    height: auto;
  }

  .gal .meet h2 {
    font-size: 30px;
    font-weight: 800;
    margin-top: 10px;
  }

  .gal .meet-traits {
    color: var(--muted);
    margin: 6px 0 18px;
    text-transform: capitalize;
  }

  .gal .meet .actions {
    justify-content: center;
  }

  .gal .meet .copy-chip {
    width: 100%;
    justify-content: space-between;
  }

  .gal .meet code {
    font-size: 12px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 720px) {
    .gal .crowd {
      grid-template-columns: repeat(auto-fill, minmax(52px, 1fr));
    }

    .gal .eight {
      justify-content: center;
    }
  }
</style>
