---
import Avatar from '../components/Avatar.astro'
import Site from '../layouts/Site.astro'

const install = 'npx skills add albertesparragoza/nurblings'
const agents = ['Claude Code', 'Cursor', 'Codex', 'GitHub Copilot', 'Gemini CLI', 'Windsurf']

const asks = [
  {
    ask: 'Give every commenter an avatar.',
    does: 'Installs the right package for your framework, seeds each avatar with the user id and names it for screen readers.',
  },
  {
    ask: 'Make the avatars match our brand.',
    does: 'Builds one createNurblings palette, wires it app-wide and fixes any colour that fails contrast.',
  },
  {
    ask: 'Open the profile with the avatar gliding in.',
    does: 'Adds a transition key in both places and wraps the change in morph(), with flushSync or nextTick where needed.',
  },
  {
    ask: 'The member list feels busy.',
    does: 'Calms the motion for long lists, keeping the blink, and leaves reduced motion to the library.',
  },
]
---

<Site title="AI skill" active="/ai/" class="aip">
  <div class="wrap">
    <section class="ai-hero">
      <div>
        <h1>Nurblings for coding agents</h1>
        <p class="lead">
          One skill gives your agent the package choice, the seeding rules, accessible names, theming and
          motion: the parts it would otherwise have to guess.
        </p>
        <div class="install-cmd">
          <code>{install}</code>
          <button type="button" data-copy={install}><span data-copy-label>Copy</span></button>
        </div>
        <p class="agents">Works with {agents.join(', ')} and any agent that reads skills.</p>
      </div>
      <div class="ai-crowd" aria-hidden="true">
        <Avatar seed="assistant" size={128} />
        <Avatar seed="copilot-friend" size={92} />
        <Avatar seed="agent-smol" size={72} />
      </div>
    </section>

    <section class="section">
      <div class="section-head">
        <h2>Requests it handles</h2>
      </div>
      <div class="asks">
        {
          asks.map((a) => (
            <article class="card ask">
              <p class="said">“{a.ask}”</p>
              <p>{a.does}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="skill-file card">
      <div>
        <h2>Inside the skill</h2>
        <ul>
          <li>The package and import for React, Next.js, Vue, Nuxt, Astro, Svelte, Angular and plain HTML.</li>
          <li>The rules that matter: stable-id seeds, accessible titles, sizes and containers.</li>
          <li>Motion, reduced motion and morph transitions, with the React and Vue timing details.</li>
          <li>Brand palettes, and how to fix a colour the contrast check rejects.</li>
          <li>The mistakes to avoid, and a checklist to verify the result.</li>
        </ul>
        <p class="note">
          It is plain Markdown in the repository: <a href="https://github.com/albertesparragoza/nurblings/tree/develop/skills/nurblings">skills/nurblings/SKILL.md</a>.
          Read it, fork it, or copy it into your own agent setup.
        </p>
      </div>
    </section>

    <p class="footnote">
      Crawlers and AI search get the usual standards too:{' '}
      <a href="/llms.txt">llms.txt</a>,{' '}
      <a href="/llms-full.txt">llms-full.txt</a> and a Markdown copy of every docs page, such as{' '}
      <a href="/docs/getting-started.md">/docs/getting-started.md</a>.
    </p>
  </div>
</Site>

<style is:global>
  .aip .ai-hero {
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: 32px;
    align-items: center;
    padding-block: clamp(40px, 7vw, 88px) 0;
  }

  .aip h1 {
    font-size: clamp(42px, 5.6vw, 80px);
    font-weight: 800;
    letter-spacing: -0.045em;
    max-width: 14ch;
  }

  .aip .install-cmd {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 28px;
    max-width: 100%;
    width: fit-content;
    background: var(--code-bg);
    color: var(--code-ink);
    border-radius: var(--r-md);
    padding: 8px 8px 8px 18px;
  }

  .aip .install-cmd code {
    font: 15px var(--mono);
    overflow-x: auto;
    white-space: nowrap;
  }

  .aip .install-cmd button {
    flex: none;
    border: 0;
    background: var(--accent);
    color: var(--on-accent);
    border-radius: 10px;
    padding: 8px 14px;
    font-weight: 700;
  }

  .aip .agents {
    color: var(--muted);
    font-size: 14px;
    margin: 14px 0 0;
  }

  .aip .ai-crowd {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 10px;
    background: var(--tint);
    border-radius: var(--r-xl);
    padding: 40px 20px;
  }

  .aip .asks {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }

  .aip .ask {
    display: grid;
    gap: 10px;
    align-content: start;
  }

  .aip .ask p {
    margin: 0;
    color: var(--muted);
  }

  .aip .ask .said {
    font: 700 22px/1.2 var(--display);
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .aip .skill-file {
    padding: clamp(22px, 3vw, 36px);
  }

  .aip .skill-file h2 {
    font-size: clamp(28px, 3vw, 38px);
    font-weight: 800;
  }

  .aip .skill-file ul {
    margin: 16px 0;
    padding-left: 20px;
    display: grid;
    gap: 8px;
    color: var(--muted);
  }

  .aip .note,
  .aip .footnote {
    color: var(--muted);
    margin: 0;
  }

  .aip .note a,
  .aip .footnote a {
    color: var(--accent-text);
  }

  .aip .footnote {
    font-size: 14px;
    padding-block: 32px 8px;
  }

  @media (max-width: 900px) {
    .aip .ai-hero,
    .aip .asks {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
