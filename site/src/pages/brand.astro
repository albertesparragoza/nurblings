---
// Nurbi is the flagship: always the default renderer, never repainted by a theme
import { nurbling } from 'nurblings'
import Site from '../layouts/Site.astro'
import { REPO } from '../lib/nav'

const draw = (seed: string, size: number) =>
  nurbling(seed, { size, background: 'circle', animate: false, title: seed })
const relatives = ['ada', 'grace', 'linus', 'radia', 'hedy', 'alan', 'joan']
const traits = [
  {
    title: 'Handles on the crown',
    text: 'Two antennae rooted at the top, one for about one in eight. Straight stems, square tips: the only sharp corners on the creature.',
    seed: 'linus',
  },
  {
    title: 'A face that reads at 24 px',
    text: 'Two eyes in a fixed band of the body, with a brow in the accent colour just above. It tilts a little and is never angry.',
    seed: 'grace',
  },
  {
    title: 'A soft, plated body',
    text: "Ten bodies stretch, widen and move Nurbi's plates around the crown, the sides or the base.",
    seed: 'radia',
  },
  {
    title: 'Flat, and no limbs',
    text: 'Solid fills and no gradients, so an avatar stays crisp from a favicon to a profile page.',
    seed: 'hedy',
  },
]
---

<Site title="Meet Nurbi" class="brandp">
  <div class="wrap">
    <section class="brand-hero">
      <figure>
        <span class="av" set:html={nurbling('nurbi', { size: 280, title: 'Nurbi' })} />
        <figcaption>Nurbi, the flagship</figcaption>
      </figure>
      <div>
        <h1>Every Nurbling is a relative of Nurbi</h1>
        <p class="lead">
          Nurbi's two antennae are bezier control handles: the tools that turn an intention into a curve.
          Nurblings borrows the idea literally. Your handle becomes its handles.
        </p>
        <div class="relatives" aria-label="A few relatives">
          {relatives.map((seed) => <span class="av" set:html={draw(seed, 52)} />)}
        </div>
      </div>
    </section>

    <section class="family-traits">
      <h2>What runs in the family</h2>
      <div class="trait-grid">
        {
          traits.map((t) => (
            <article class="card">
              <span class="av" set:html={draw(t.seed, 72)} />
              <h3>{t.title}</h3>
              <p>{t.text}</p>
            </article>
          ))
        }
      </div>
    </section>

    <section class="reserved panel">
      <span class="av" set:html={nurbling('nurbi', { size: 96, background: 'circle', animate: false, title: 'Nurbi' })} />
      <div>
        <h2>There is only one Nurbi</h2>
        <p>
          A few reserved seeds, such as <code>nurbi</code>, show the original. Every other seed is kept a clear step
          away from it: no generated avatar gets Nurbi's body, colours or bare face.
        </p>
      </div>
    </section>

    <section class="rules">
      <div class="card">
        <h2>Free to use</h2>
        <ul>
          <li>The library and every avatar it generates, in any project, commercial or not.</li>
          <li>Generated avatars are public domain under CC0: no attribution needed.</li>
          <li>Saying your project uses, or is built with, Nurblings.</li>
          <li>Forking the code under MIT, with a name of your own.</li>
        </ul>
      </div>
      <div class="card">
        <h2>Ask first</h2>
        <ul>
          <li>Publishing a fork, package or service under the Nurblings or Nurbi name.</li>
          <li>Using Nurbi as a mascot, logo or endorsement.</li>
        </ul>
        <p>
          The full terms are in <a href={`${REPO}/blob/develop/TRADEMARKS.md`}>TRADEMARKS.md</a>. Unsure?{' '}
          <a href={`${REPO}/issues`}>Open an issue</a> and ask.
        </p>
      </div>
    </section>
  </div>
</Site>

<style is:global>
  .brandp .brand-hero {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(24px, 5vw, 64px);
    align-items: center;
    padding-block: clamp(40px, 7vw, 88px);
  }

  .brandp figure {
    margin: 0;
    display: grid;
    justify-items: center;
    gap: 12px;
    background: var(--tint);
    border-radius: var(--r-xl);
    padding: 32px;
  }

  .brandp figcaption {
    font-size: 13px;
    font-weight: 600;
    color: var(--muted);
  }

  .brandp h1 {
    font-size: clamp(40px, 5vw, 68px);
    font-weight: 800;
    letter-spacing: -0.04em;
    max-width: 14ch;
  }

  .brandp .relatives {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 28px;
  }

  .brandp h2 {
    font-size: clamp(28px, 3.4vw, 40px);
    font-weight: 800;
  }

  .brandp .family-traits {
    padding-bottom: clamp(40px, 6vw, 72px);
  }

  .brandp .trait-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    margin-top: 24px;
  }

  .brandp .trait-grid h3 {
    font-size: 20px;
    font-weight: 800;
    margin-top: 14px;
  }

  .brandp .trait-grid p {
    color: var(--muted);
    margin: 8px 0 0;
  }

  .brandp .reserved {
    display: flex;
    align-items: center;
    gap: clamp(16px, 4vw, 40px);
    margin-bottom: clamp(40px, 6vw, 72px);
  }

  .brandp .reserved p {
    color: var(--muted);
    max-width: 60ch;
    margin: 10px 0 0;
  }

  .brandp .rules {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    padding-bottom: 40px;
  }

  .brandp .rules h2 {
    font-size: 30px;
  }

  .brandp .rules ul {
    padding-left: 20px;
    display: grid;
    gap: 8px;
    color: var(--muted);
  }

  .brandp .rules a {
    color: var(--accent-text);
  }

  @media (max-width: 900px) {
    /* minmax(0, …) lets the one column shrink below its content, such as Nurbi's figure */
    .brandp .brand-hero,
    .brandp .rules {
      grid-template-columns: minmax(0, 1fr);
    }

    .brandp figure .av svg {
      width: min(280px, 100%);
      height: auto;
    }
  }

  @media (max-width: 560px) {
    .brandp .reserved {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
